# ============================================================
# CrewDock Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# --- Required: Ollama LLM provider ---

# Ollama is the only supported provider. Cloud is the default — fill in your API key.
# To switch to a local Ollama, set OLLAMA_HOST to http://host.docker.internal:11434
# and leave OLLAMA_API_KEY empty.
#
# Cloud (default):  OLLAMA_HOST=https://ollama.com + OLLAMA_API_KEY=ol-...
# Local:            OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# Default model for all agents.
OLLAMA_MODEL=gemma4:31b

# --- Optional: per-agent model overrides ---
# Use an agent's id (uppercased) — e.g. OLLAMA_MODEL_SCOUTER overrides OLLAMA_MODEL
# for Scouter only. Leave unset to use the default. The `main` agent's override
# is OLLAMA_MODEL_OVERLORD.
#
# OLLAMA_MODEL_OVERLORD=llama3.1:8b
# OLLAMA_MODEL_SCOUTER=qwen2.5:14b
# OLLAMA_MODEL_ALFRED=llama3.1:70b

# --- Discord (optional, agents work without it) ---

# Each agent gets its own Discord bot token and channel.
# Leave blank to skip that agent's Discord integration.
DISCORD_SCOUTER_TOKEN=
DISCORD_SCOUTER_CHANNEL=
DISCORD_ALFRED_TOKEN=
DISCORD_ALFRED_CHANNEL=

# Discord server (guild) ID -- required if any agent tokens are set
DISCORD_GUILD=

# --- X/Twitter API (optional, for Scouter) ---

# Bearer token for read-only X API v2 access (tweet search, lists, mentions).
# Get one at: https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=

# Client credentials (only needed for OAuth 2.0 user-context auth, not required for read-only)
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Gateway (auto-managed) ---

# Gateway auth token. Generated on first boot if not set.
# Set explicitly to use a fixed token across rebuilds.
OPENCLAW_GATEWAY_TOKEN=
